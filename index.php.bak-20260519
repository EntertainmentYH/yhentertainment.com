                                <?php
                                // 渲染留言列表（最新在前）
                                $messages_file = $statistics_dir . '/messages.json';
                                $messages = [];
                                if (file_exists($messages_file)) {
                                    $contents = @file_get_contents($messages_file);
                                    $decoded = $contents ? json_decode($contents, true) : [];
                                    if (is_array($decoded)) $messages = $decoded;
                                }
                                usort($messages, function($a, $b) {
                                    return ($b['ts'] ?? 0) <=> ($a['ts'] ?? 0);
                                });

                                foreach ($messages as $m):
                                    $user = htmlspecialchars($m['user_id'] ?? '用户');
                                    $content = htmlspecialchars($m['search'] ?? '');
                                    $month = '';
                                    $day = '';
                                    $year = '';
                                    $day_suffix = '';
                                    if (isset($m['ts'])) {
                                        $t = (int)$m['ts'];
                                        // force display in China timezone (UTC+8)
                                        try {
                                            $dt = new DateTime('@' . $t);
                                            $tzObj = new DateTimeZone('Asia/Shanghai');
                                            $dt->setTimezone($tzObj);
                                            $month = $dt->format('F');
                                            $day = (int)$dt->format('j');
                                            $year = $dt->format('Y');
                                            $time_hms = $dt->format('H:i:s');
                                            $tz_label = 'UTC+8';
                                            // english ordinal suffix
                                            $mod100 = $day % 100;
                                            if ($mod100 >= 11 && $mod100 <= 13) {
                                                $day_suffix = 'th';
                                            } else {
                                                switch ($day % 10) {
                                                    case 1: $day_suffix = 'st'; break;
                                                    case 2: $day_suffix = 'nd'; break;
                                                    case 3: $day_suffix = 'rd'; break;
                                                    default: $day_suffix = 'th'; break;
                                                }
                                            }
                                        } catch (Exception $e) {
                                            $month = date('F', $t);
                                            $day = (int)date('j', $t);
                                            $year = date('Y', $t);
                                            $time_hms = date('H:i:s', $t);
                                            $tz_label = 'UTC+8';
                                        }
                                    }
                                ?>

