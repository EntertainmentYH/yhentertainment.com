<?php
// 做出的临时性修改
// 1.暂时禁用离线屏蔽词
// 2.暂时禁用IP限制
// Enable error display/logging temporarily for debugging HTTP 500
ini_set('display_errors', 1);
ini_set('display_startup_errors', 1);
ini_set('log_errors', 1);
error_reporting(E_ALL);
$log_dir = __DIR__ . '/statistics';
if (!is_dir($log_dir)) @mkdir($log_dir, 0777, true);
ini_set('error_log', $log_dir . '/php_error.log');
$ip = $_SERVER['REMOTE_ADDR'] ?? '';
// start session for flash messages
if (session_status() === PHP_SESSION_NONE) session_start();

// Provide lightweight mbstring fallbacks when mbstring extension is not available
if (!function_exists('mb_strlen')) {
    function mb_strlen($str, $encoding = 'UTF-8') {
        if ($encoding !== 'UTF-8') {
            $str = mb_convert_encoding($str, 'UTF-8', $encoding);
        }
        $arr = preg_split('//u', $str, -1, PREG_SPLIT_NO_EMPTY);
        return $arr === false ? strlen($str) : count($arr);
    }
}
if (!function_exists('mb_substr')) {
    function mb_substr($str, $start, $length = NULL, $encoding = 'UTF-8') {
        if ($encoding !== 'UTF-8' && function_exists('mb_convert_encoding')) {
            $str = mb_convert_encoding($str, 'UTF-8', $encoding);
        }
        $arr = preg_split('//u', $str, -1, PREG_SPLIT_NO_EMPTY);
        if ($arr === false) return '';
        if ($length === NULL) {
            $slice = array_slice($arr, $start);
        } else {
            $slice = array_slice($arr, $start, $length);
        }
        return implode('', $slice);
    }
}

// Provide mb_stripos fallback if mbstring not available
if (!function_exists('mb_stripos')) {
    function mb_stripos($haystack, $needle, $offset = 0, $encoding = 'UTF-8') {
        if ($needle === '') return 0;
        // normalize encoding if possible
        if ($encoding !== 'UTF-8' && function_exists('mb_convert_encoding')) {
            $haystack = mb_convert_encoding($haystack, 'UTF-8', $encoding);
            $needle = mb_convert_encoding($needle, 'UTF-8', $encoding);
            $encoding = 'UTF-8';
        }

        // helper to lowercase using mb_strtolower when available
        $lower = function($s) use ($encoding) {
            if (function_exists('mb_strtolower')) return mb_strtolower($s, $encoding);
            return strtolower($s);
        };

        $hay_len = mb_strlen($haystack, $encoding);
        $needle_len = mb_strlen($needle, $encoding);
        if ($offset < 0) $offset = 0;
        if ($needle_len === 0) return 0;

        $hay_lower = $lower($haystack);
        $needle_lower = $lower($needle);

        // linear search using mb_substr
        for ($i = $offset; $i <= $hay_len - $needle_len; $i++) {
            $chunk = mb_substr($hay_lower, $i, $needle_len, $encoding);
            if ($chunk === $needle_lower) return $i;
        }
        return false;
    }
}

// 读取配置
$config_file = __DIR__ . '/configuration.json';
$config = [];
if (file_exists($config_file)) {
    $config = json_decode(file_get_contents($config_file), true);
}

// 默认语言
$lang_code = 'zh-cn';

// 1. 尝试使用 ip-api.com 检测国家代码
$ip = $_SERVER['REMOTE_ADDR'];
$json = @file_get_contents("http://ip-api.com/json/$ip");
$data = json_decode($json, true);

if ($data && $data['status'] === 'success') {
    $country_code = strtoupper($data['countryCode']);
    // capture timezone returned by ip-api (e.g. "Asia/Shanghai")
    $visitor_timezone = !empty($data['timezone']) ? $data['timezone'] : null;
    if ($visitor_timezone) setcookie('visitor_tz', $visitor_timezone, time()+3600*24*30, '/');
} elseif (isset($_COOKIE['country_code'])) {
    // 2. IP 检测失败，尝试使用 Cookie
    $country_code = strtoupper($_COOKIE['country_code']);
    $visitor_timezone = $_COOKIE['visitor_tz'] ?? null;
} else {
    $country_code = ''; // 没有任何来源
    $visitor_timezone = $_COOKIE['visitor_tz'] ?? null;
}

// 根据国家代码匹配语言
switch ($country_code) {
    case 'US': // United States
    case 'CA': // Canada
    case 'GB': // United Kingdom
    case 'AU': // Australia
    case 'NZ': // New Zealand
    case 'IE': // Ireland
    case 'SG': // Singapore
    case 'EN': // England
        $lang_code = 'en';
        break;
    case 'TW': // Taiwan
    case 'HK': // Hong Kong
    case 'MO': // Macau
        $lang_code = 'zh-tw';
        break;
    case 'CN': // China
        $lang_code = 'zh-cn';
        break;
    case 'JP': // Japan
        $lang_code = 'jp';
        break;
    case 'RU': // Russia
    case 'UA': // Ukraine
        $lang_code = 'ru';
        break;
    default:
        $lang_code = 'zh-cn';
        break;
}

// Ensure we have a timezone string; fallback to server default if none
if (empty($visitor_timezone)) {
    try {
        $visitor_timezone = date_default_timezone_get();
    } catch(Exception $e) {
        $visitor_timezone = 'UTC';
    }
}

// 3. 最后优先 GET 覆盖（如果有参数）
if (isset($_GET['lang'])) {
    $lang = strtolower($_GET['lang']);
    switch ($lang) {
        case 'zh-cn':
            $lang_code = 'zh-cn';
            $country_code = 'CN';
            break;
        case 'en':
            $lang_code = 'en';
            $country_code = 'EN';
            break;
        case 'zh-tw':
            $lang_code = 'zh-tw';
            $country_code = 'TW';
            break;
        case 'jp':
            $lang_code = 'jp';
            $country_code = 'JP';
            break;
        case 'ru':
            $lang_code = 'ru';
            $country_code = 'RU';
            break;
        default:
            // 无效参数则不变
            break;
    }
}

// 保存国家代码到 Cookie
if (!empty($country_code)) {
    setcookie('country_code', $country_code, time() + 3600 * 24 * 30, '/');
}

// 加载语言包
$lang_file = __DIR__ . "/languages/{$lang_code}.json";
if (!file_exists($lang_file)) {
    $lang_file = __DIR__ . "/languages/zh-cn.json";
}
$lang = json_decode(@file_get_contents($lang_file), true) ?? [];

// 读取对应语言文件
$lang_file = __DIR__ . "/languages/{$lang_code}.json";
if (!file_exists($lang_file)) {
    $lang_file = __DIR__ . "/languages/zh-cn.json"; // 回退
}
$lang = json_decode(@file_get_contents($lang_file), true) ?? [];

// 统计文件路径
$statistics_dir = __DIR__ . '/statistics';
if (!is_dir($statistics_dir))
    mkdir($statistics_dir, 0777, true);

$daily_counter_file = "{$statistics_dir}/daily_counter.json";
$total_counter_file = "{$statistics_dir}/total_counter.json";
$online_file = "{$statistics_dir}/online.txt";

// 日期
$today = date('Y-m-d');

// ========== 防刷访问量 ==========
// 每个IP冷却时间（秒）
$ip_limit_seconds = 10;
$ip_limiter_file = "{$statistics_dir}/ip_limiter.json";
$ip_limiter = [];
if (file_exists($ip_limiter_file)) {
    $ip_limiter = json_decode(file_get_contents($ip_limiter_file), true);
    if (!is_array($ip_limiter))
        $ip_limiter = [];
}
$now_time = time();
$ip = $_SERVER['REMOTE_ADDR'];
$can_count = false;
if (!isset($ip_limiter[$ip]) || ($now_time - $ip_limiter[$ip]) > $ip_limit_seconds) {
    $can_count = true;
    $ip_limiter[$ip] = $now_time;
    file_put_contents($ip_limiter_file, json_encode($ip_limiter, JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT));
}

// ========== 单日访问量 ==========
$daily_data = [];
if (file_exists($daily_counter_file)) {
    $daily_data = json_decode(file_get_contents($daily_counter_file), true);
    if (!is_array($daily_data))
        $daily_data = [];
}
switch (true) {
    case !isset($daily_data[$today]):
        $daily_data[$today] = 1;
        break;
    default:
        $daily_data[$today]++;
        break;
}
file_put_contents($daily_counter_file, json_encode($daily_data, JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT));
$today_count = $daily_data[$today];

// ========== 总访问量 ==========
$total_count = 0;
if (file_exists($total_counter_file)) {
    $total_count = (int) file_get_contents($total_counter_file);
}
$total_count++;
file_put_contents($total_counter_file, $total_count);

// ========== 在线人数 ==========
$timeout = 1; // 1s
$ip = $_SERVER['REMOTE_ADDR'];
$now = time();
$onlines = [];
$new_onlines = [];
$found = false;
if (file_exists($online_file)) {
    $onlines = file($online_file, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    foreach ($onlines as $line) {
        [$online_ip, $last_time] = explode('|', $line);
        if ($now - $last_time < $timeout) {
            if ($online_ip == $ip) {
                if (!$found) { // 只更新一次当前IP
                    $new_onlines[] = "$ip|$now";
                    $found = true;
                }
                // 如果已经添加过当前IP，则跳过
            } else {
                $new_onlines[] = "$online_ip|$last_time";
            }
        }
    }
}
if (!$found) {
    $new_onlines[] = "$ip|$now";
}
file_put_contents($online_file, implode("\n", $new_onlines));
$online_count = count($new_onlines);

// ========== 网站运行时长 ==========
$site_days = '';
if (!empty($config['site_start_date'])) {
    $site_days = '1';
    $start = strtotime($config['site_start_date']);
    $now = strtotime(date('Y-m-d'));

    if ($start && $now >= $start) {
        $site_days = floor(($now - $start) / 86400) + 1;
    }
}

//POST 用户留言逻辑
$submit_result = null;
if ($_SERVER['REQUEST_METHOD'] === 'POST' && !empty($_POST['action'])) {
    $action = $_POST['action'];
    $messages_file = $statistics_dir . '/messages.json';
    if (!is_dir($statistics_dir)) @mkdir($statistics_dir, 0777, true);
    if (!file_exists($messages_file)) @file_put_contents($messages_file, json_encode([], JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT));

    // load messages
    $messages = [];
    $contents = @file_get_contents($messages_file);
    if ($contents !== false) {
        $decoded = json_decode($contents, true);
        if (is_array($decoded)) $messages = $decoded;
    }

    // delete action: remove messages from same IP
    if ($action === 'delete_message') {
        $myip = $_SERVER['REMOTE_ADDR'] ?? '';
        $delete_id = $_POST['delete_id'] ?? null;
        // remove only the message that matches both id and IP
        $new = array_values(array_filter($messages, function($itm) use ($myip, $delete_id) {
            if (!isset($itm['id'])) return true;
            if ($delete_id !== null) {
                // keep items that are NOT the one to delete
                return !($itm['id'] === $delete_id && isset($itm['ip']) && $itm['ip'] === $myip);
            }
            // fallback: if no id provided, remove all from this IP
            return !isset($itm['ip']) || $itm['ip'] !== $myip;
        }));
        $ok = @file_put_contents($messages_file, json_encode($new, JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT), LOCK_EX);
        if ($ok === false) {
            $submit_result = ['ok' => false, 'error' => 'delete_failed'];
        } else {
            // also remove any ip limiter entry so the IP is not blocked for an hour after delete
            if (file_exists($ip_limiter_file)) {
                $lim = json_decode(@file_get_contents($ip_limiter_file), true);
                if (is_array($lim) && isset($lim[$myip])) {
                    unset($lim[$myip]);
                    @file_put_contents($ip_limiter_file, json_encode($lim, JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT), LOCK_EX);
                }
            }
            $anchor_in = $_POST['anchor'] ?? null;
            $submit_result = ['ok' => true, 'deleted' => true, 'anchor' => $anchor_in];
        }
    }

    // submit action: enforce per-IP 1 per hour and remove older same-IP messages when posting allowed
    if ($action === 'submit_message') {
        $title = trim($_POST['title'] ?? '');
        $search = trim($_POST['search'] ?? '');
        $user_id = trim($_POST['user_id'] ?? '');
        $myip = $_SERVER['REMOTE_ADDR'] ?? '';

        // ===== 屏蔽词检测 =====
        $blocked_file = $statistics_dir . '/blocked_words.json';
        if (!file_exists($blocked_file)) @file_put_contents($blocked_file, json_encode([], JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT));
        $blocked_words = [];
        $bw_contents = @file_get_contents($blocked_file);
        $bw_dec = $bw_contents ? json_decode($bw_contents, true) : [];
        if (is_array($bw_dec)) $blocked_words = $bw_dec;

        // optional remote update if configured (disabled by default)
        if (!empty($config['blocked_words_auto_update']) && !empty($config['blocked_words_source'])) {
            $src = $config['blocked_words_source'];
            $remote = @file_get_contents($src);
            $rd = $remote ? json_decode($remote, true) : null;
            if (is_array($rd)) {
                $blocked_words = $rd;
                @file_put_contents($blocked_file, json_encode($blocked_words, JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT), LOCK_EX);
            }
        }

        // detection helper: case-insensitive substring match
        $detect_blocked = function($text) use ($blocked_words) {
            $text = (string)$text;
            foreach ($blocked_words as $bw) {
                $bw = trim((string)$bw);
                if ($bw === '') continue;
                if (mb_stripos($text, $bw) !== false) return $bw;
            }
            return false;
        };

        // check title, content, nickname
        $combined = $title . "\n" . $search . "\n" . $user_id;

        // By default, local blocklist can be enabled/disabled via configuration.json
        // Set "use_local_blocklist": false to disable local substring blocking and rely solely on Deepseek
        $blocked_found = false;
        if (!empty($config['use_local_blocklist'])) {
            $blocked_found = $detect_blocked($combined);
            if ($blocked_found !== false) {
                // record an alarm log for local block
                $alarm_file = $statistics_dir . '/blocked_attempts.log';
                $snippet = mb_substr($search, 0, 200);
                $log_line = date('c') . " | IP:" . ($myip) . " | matched:" . $blocked_found . " | snippet:" . str_replace("\n", ' ', $snippet) . "\n";
                @file_put_contents($alarm_file, $log_line, FILE_APPEND | LOCK_EX);
                $submit_result = ['ok' => false, 'error' => 'blocked_word', 'blocked_word' => $blocked_found];

                // send to deepseek for logging/analysis as well (non-blocking)
                if (!empty($config['deepseek_enabled'])) {
                    $endpoint = !empty($config['deepseek_endpoint']) ? $config['deepseek_endpoint'] : 'https://api.deepseek.example/v1/moderate';
                    $api_key = !empty($config['deepseek_api_key']) ? $config['deepseek_api_key'] : null;
                    $chat_body = json_encode([
                        'model' => 'deepseek-v4-pro',
                        'messages' => [
                            ['role' => 'system', 'content' => 'You are a content moderation assistant. Respond in JSON with keys {"blocked": boolean, "reason": string, "violations": []} when applicable.'],
                            ['role' => 'user', 'content' => $combined]
                        ],
                        'thinking' => ['type' => 'enabled'],
                        'reasoning_effort' => 'high',
                        'stream' => false
                    ], JSON_UNESCAPED_UNICODE);
                    $ds_response = null;
                    if (function_exists('curl_init')) {
                        $ch = curl_init();
                        curl_setopt($ch, CURLOPT_URL, $endpoint);
                        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
                        curl_setopt($ch, CURLOPT_POST, true);
                        curl_setopt($ch, CURLOPT_POSTFIELDS, $chat_body);
                        $headers = ['Content-Type: application/json'];
                        if ($api_key) $headers[] = 'Authorization: Bearer ' . $api_key;
                        curl_setopt($ch, CURLOPT_HTTPHEADER, $headers);
                        curl_setopt($ch, CURLOPT_TIMEOUT, 4);
                        $ds_response = @curl_exec($ch);
                        @curl_close($ch);
                    } else {
                        $opts = array('http' => array(
                            'method' => 'POST',
                            'header' => "Content-Type: application/json\r\n" . ($api_key ? "Authorization: Bearer $api_key\r\n" : ''),
                            'content' => $chat_body,
                            'timeout' => 4
                        ));
                        $context = stream_context_create($opts);
                        $ds_response = @file_get_contents($endpoint, false, $context);
                    }
                    try { @file_put_contents($statistics_dir . '/deepseek_responses.log', date('c') . " | fire_and_forget_response: " . ($ds_response ?? '') . "\n", FILE_APPEND | LOCK_EX); } catch(Exception $e) {}
                }
            }
        }

        // If not locally blocked, call Deepseek (if enabled) to determine blocking
        if (empty($submit_result) && !empty($config['deepseek_enabled'])) {
            $deepseek_blocked = false;
            $deepseek_detail = null;
            $endpoint = !empty($config['deepseek_endpoint']) ? $config['deepseek_endpoint'] : 'https://api.deepseek.example/v1/moderate';
            $api_key = !empty($config['deepseek_api_key']) ? $config['deepseek_api_key'] : null;
            $chat_body = json_encode([
                'model' => 'deepseek-v4-pro',
                'messages' => [
                    ['role' => 'system', 'content' => 'You are a content moderation assistant. Respond in JSON with keys {"blocked": boolean, "reason": string, "violations": []} when applicable.'],
                    ['role' => 'user', 'content' => $combined]
                ],
                'thinking' => ['type' => 'enabled'],
                'reasoning_effort' => 'high',
                'stream' => false
            ], JSON_UNESCAPED_UNICODE);
            $response = null;
            if (function_exists('curl_init')) {
                $ch = curl_init();
                curl_setopt($ch, CURLOPT_URL, $endpoint);
                curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
                curl_setopt($ch, CURLOPT_POST, true);
                curl_setopt($ch, CURLOPT_POSTFIELDS, $chat_body);
                $headers = ['Content-Type: application/json'];
                if ($api_key) $headers[] = 'Authorization: Bearer ' . $api_key;
                curl_setopt($ch, CURLOPT_HTTPHEADER, $headers);
                curl_setopt($ch, CURLOPT_TIMEOUT, 8);
                $response = @curl_exec($ch);
                curl_close($ch);
            } else {
                $opts = array('http' => array(
                    'method' => 'POST',
                    'header' => "Content-Type: application/json\r\n" . ($api_key ? "Authorization: Bearer $api_key\r\n" : ''),
                    'content' => $chat_body,
                    'timeout' => 8
                ));
                $context = stream_context_create($opts);
                $response = @file_get_contents($endpoint, false, $context);
            }

            // write raw response for debugging
            try { @file_put_contents($statistics_dir . '/deepseek_responses.log', date('c') . " | response: " . ($response ?? '') . "\n", FILE_APPEND | LOCK_EX); } catch(Exception $e) {}

            if ($response) {
                $dec = @json_decode($response, true);
                if (is_array($dec)) {
                    if (!empty($dec['blocked']) || !empty($dec['violation']) || (!empty($dec['violations']) && count($dec['violations'])>0)) {
                        $deepseek_blocked = true;
                        $deepseek_detail = json_encode($dec, JSON_UNESCAPED_UNICODE);
                    }
                    // try to interpret chat-style content
                    if (!$deepseek_blocked && !empty($dec['choices']) && is_array($dec['choices']) && !empty($dec['choices'][0]['message']['content'])) {
                        $content = $dec['choices'][0]['message']['content'];
                        $inner = @json_decode($content, true);
                        if (is_array($inner) && (!empty($inner['blocked']) || !empty($inner['violations']))) {
                            $deepseek_blocked = !empty($inner['blocked']) || (!empty($inner['violations']) && count($inner['violations'])>0);
                            $deepseek_detail = json_encode($inner, JSON_UNESCAPED_UNICODE);
                        } else {
                            $low = mb_strtolower($content);
                            if (mb_stripos($low, 'violation') !== false || mb_stripos($low, 'not allowed') !== false || mb_stripos($low, 'unsafe') !== false || mb_stripos($low, 'blocked') !== false) {
                                $deepseek_blocked = true;
                                $deepseek_detail = mb_substr($content, 0, 800);
                            }
                        }
                    }
                }
            }

            if ($deepseek_blocked) {
                $alarm_file = $statistics_dir . '/blocked_attempts.log';
                $snippet = mb_substr($search, 0, 200);
                $log_line = date('c') . " | IP:" . ($myip) . " | deepseek_blocked | detail:" . str_replace("\n", ' ', $deepseek_detail) . " | snippet:" . str_replace("\n", ' ', $snippet) . "\n";
                @file_put_contents($alarm_file, $log_line, FILE_APPEND | LOCK_EX);
                $submit_result = ['ok' => false, 'error' => 'deepseek_blocked', 'detail' => $deepseek_detail];
            }
        }

        // missing fields check
        if (empty($submit_result) && ($search === '' || $user_id === '')) {
            $submit_result = ['ok' => false, 'error' => 'missing_fields'];
        }
        // continue if not blocked
        if (!empty($submit_result) && $submit_result['ok'] === false) {
            // blocked or error already set, skip persisting
        } else {
            if (mb_strlen($title) > 150) $title = mb_substr($title, 0, 150);
            if (mb_strlen($search) > 500) $search = mb_substr($search, 0, 500);
            if (mb_strlen($user_id) > 100) $user_id = mb_substr($user_id, 0, 100);

            // find latest message from this IP
            $last_ts = 0;
            foreach ($messages as $itm) {
                if (isset($itm['ip']) && $itm['ip'] === $myip && isset($itm['ts'])) {
                    $last_ts = max($last_ts, (int)$itm['ts']);
                }
            }
            $now = time();
            // allow disabling rate limit for testing via configuration.json -> "disable_rate_limit": true
            $rate_limit_seconds = !empty($config['disable_rate_limit']) ? 0 : 3600;
            if ($rate_limit_seconds > 0 && $last_ts > 0 && ($now - $last_ts) < $rate_limit_seconds) {
                $remain = $rate_limit_seconds - ($now - $last_ts);
                $submit_result = ['ok' => false, 'error' => 'rate_limited', 'retry_after' => $remain];
            } else {
                // remove previous messages from same IP (if any), keep all others
                $new_messages = array_values(array_filter($messages, function($itm) use ($myip) {
                    return !isset($itm['ip']) || $itm['ip'] !== $myip;
                }));

                $search_clean = htmlspecialchars(strip_tags($search), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
                $user_id_clean = htmlspecialchars(strip_tags($user_id), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
                $title_clean = htmlspecialchars(strip_tags($title), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');

                $record = [
                    'title' => $title_clean !== '' ? $title_clean : '',
                    'id' => uniqid('', true),
                    'user_id' => $user_id_clean,
                    'search' => $search_clean,
                    'ip' => $myip,
                    'ts' => $now,
                ];

                // append new message to the filtered list (keeps all other IPs' messages)
                $new_messages[] = $record;
                $ok = @file_put_contents($messages_file, json_encode($new_messages, JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT), LOCK_EX);
                if ($ok === false) {
                    $submit_result = ['ok' => false, 'error' => 'write_failed'];
                } else {
                    $submit_result = ['ok' => true, 'record' => $record];
                }
            }
        }
    }

    $is_ajax = (!empty($_SERVER['HTTP_X_REQUESTED_WITH']) && strtolower($_SERVER['HTTP_X_REQUESTED_WITH']) === 'xmlhttprequest')
        || (strpos($_SERVER['HTTP_ACCEPT'] ?? '', 'application/json') !== false);

    // On successful non-AJAX POST, use PRG: store flash and redirect to avoid resubmission on refresh
    if (!$is_ajax && !empty($submit_result['ok'])) {
        $_SESSION['flash_submit_result'] = $submit_result;
        // redirect to current URL (preserve query string)
        $base = (isset($_SERVER['HTTPS']) && $_SERVER['HTTPS'] === 'on' ? 'https://' : 'http://') . ($_SERVER['HTTP_HOST'] ?? '') . strtok($_SERVER['REQUEST_URI'], '?');
        // priority: explicit anchor returned by handler (delete or custom), then newly created record id
        $redirect = $base;
        if (!empty($submit_result['anchor'])) {
            $a = (string)$submit_result['anchor'];
            if (strpos($a, '#') !== 0) $a = '#' . ltrim($a, '#');
            $redirect = $base . $a;
        } elseif (!empty($submit_result['record']['id'])) {
            $anchor = '#msg-' . urlencode($submit_result['record']['id']);
            $redirect = $base . $anchor;
        }
        header('Location: ' . $redirect);
        exit;
    }

    if ($is_ajax) {
        header('Content-Type: application/json; charset=utf-8');
        echo json_encode($submit_result, JSON_UNESCAPED_UNICODE);
        exit;
    }
}

// On GET, restore flash message if set
if (empty($submit_result) && !empty($_SESSION['flash_submit_result'])) {
    $submit_result = $_SESSION['flash_submit_result'];
    unset($_SESSION['flash_submit_result']);
}

