        <div id="toast-container" aria-live="polite" aria-atomic="true"></div>

        <script>
        // Move inline .alarm elements into floating toast popups
        document.addEventListener('DOMContentLoaded', function(){
            // restore scroll position if any saved and no anchor in URL
            try {
                var saved = sessionStorage.getItem('yh_scroll');
                if (saved !== null) {
                    var y = parseInt(saved,10) || 0;
                    // only override when URL has no hash (anchor) or page is at top
                    if (!location.hash || location.hash === '') {
                        window.scrollTo(0, y);
                        setTimeout(function(){ window.scrollTo(0, y); }, 50);
                        setTimeout(function(){ window.scrollTo(0, y); }, 300);
                        setTimeout(function(){ window.scrollTo(0, y); }, 800);
                        setTimeout(function(){ window.scrollTo(0, y); }, 1400);
                        window.addEventListener('load', function(){ setTimeout(function(){ window.scrollTo(0, y); }, 50); });
                    } else if (window.scrollY === 0) {
                        // if anchor exists but browser left us at top, still try to restore
                        window.scrollTo(0, y);
                        setTimeout(function(){ window.scrollTo(0, y); }, 300);
                    }
                    // remove saved value after some time to avoid stale restores
                    setTimeout(function(){ try{ sessionStorage.removeItem('yh_scroll'); } catch(e){} }, 1600);
                }
            } catch(e){}

            // save scroll on any form submit so after reload we can restore
            document.addEventListener('submit', function(e){
                try { sessionStorage.setItem('yh_scroll', Math.max(0, Math.round(window.scrollY || 0))); } catch(e){}
            }, true);

            // backup: save scroll on beforeunload in case submit did not fire
            window.addEventListener('beforeunload', function(){
                try { sessionStorage.setItem('yh_scroll', Math.max(0, Math.round(window.scrollY || 0))); } catch(e){}
            });

            var toastContainer = document.getElementById('toast-container');
            if (!toastContainer) return;

            // expose a global helper to show toasts programmatically
            window.showToast = function(message, opts){
                opts = opts || {};
                var kind = opts.kind || 'info'; // 'success' | 'error' | 'info'
                var sticky = !!opts.sticky;
                var t = document.createElement('div');
                t.className = 'alarm ' + (kind === 'success' ? 'toast toast-success alarm-success' : (kind === 'error' ? 'toast toast-error alarm-error' : 'toast toast-success alarm-success'));
                t.setAttribute('role','status');
                var span = document.createElement('div');
                span.innerHTML = message;
                t.appendChild(span);
                toastContainer.appendChild(t);

                // compute page background and text color and apply
                try {
                    var bodyStyle = window.getComputedStyle(document.body);
                    var pageBg = bodyStyle && bodyStyle.backgroundColor ? bodyStyle.backgroundColor : '#ffffff';
                    var pageColor = bodyStyle && bodyStyle.color ? bodyStyle.color : '#111';
                    t.style.background = pageBg;
                    t.style.color = pageColor;
                } catch(e){}

                t.style.transition = 'transform .36s cubic-bezier(.2,.9,.2,1), opacity .36s ease';
                t.style.transform = 'translateX(120%)';
                t.style.opacity = '0';
                requestAnimationFrame(function(){ void t.offsetHeight; t.style.transform = 'translateX(0)'; t.style.opacity = '1'; });

                function hideToastNode(node, delay){
                    delay = typeof delay === 'number' ? delay : 3000;
                    setTimeout(function(){ requestAnimationFrame(function(){ void node.offsetHeight; node.style.transform = 'translateX(120%)'; node.style.opacity = '0'; }); var rm=function(){ try{ node.removeEventListener('transitionend', rm); }catch(e){}; try{ node.parentNode && node.parentNode.removeChild(node); }catch(e){} }; node.addEventListener('transitionend', rm); setTimeout(function(){ try{ node.remove(); } catch(e){} }, 900); }, delay);
                }

                if (!sticky) hideToastNode(t, opts.delay || 3000);
                t.addEventListener('click', function(){ hideToastNode(t, 10); });
                return t;
            };
            var alarms = document.querySelectorAll('.alarm');
            alarms.forEach(function(a){
                var text = a.textContent.trim();
                if (!text) return;
                // create toast element (no close button)
                var t = document.createElement('div');
                t.className = 'alarm ' + (a.classList.contains('alarm-success') ? 'toast toast-success alarm-success' : 'toast toast-error alarm-error');
                t.setAttribute('role','status');
                var span = document.createElement('div');
                span.innerHTML = a.innerHTML; // preserve markup
                // hide original
                a.style.display = 'none';
                t.appendChild(span);
                toastContainer.appendChild(t);
                // compute page background and text color, apply as inline background to ensure non-transparent look
                try {
                    var bodyStyle = window.getComputedStyle(document.body);
                    var pageBg = bodyStyle && bodyStyle.backgroundColor ? bodyStyle.backgroundColor : '#ffffff';
                    var pageColor = bodyStyle && bodyStyle.color ? bodyStyle.color : '#111';
                    t.style.background = pageBg;
                    t.style.color = pageColor;
                } catch(e){}

                // ensure inline transition works even if CSS overridden
                t.style.transition = 'transform .36s cubic-bezier(.2,.9,.2,1), opacity .36s ease';
                // start hidden offscreen
                t.style.transform = 'translateX(120%)';
                t.style.opacity = '0';

                // show with animation (slide in from right)
                requestAnimationFrame(function(){
                    // force reflow
                    void t.offsetHeight;
                    t.style.transform = 'translateX(0)';
                    t.style.opacity = '1';
                });

                // helper to hide and remove element cleanly (uses transitionend)
                function hideToast(node, delay){
                    delay = typeof delay === 'number' ? delay : 3000;
                    setTimeout(function(){
                        requestAnimationFrame(function(){
                            // force reflow then start hide
                            void node.offsetHeight;
                            node.style.transform = 'translateX(120%)';
                            node.style.opacity = '0';
                        });
                        // remove after transition completes
                        var rm = function(){ try{ node.removeEventListener('transitionend', rm); }catch(e){}; try{ node.parentNode && node.parentNode.removeChild(node); }catch(e){} };
                        node.addEventListener('transitionend', rm);
                        // fallback removal in case transitionend doesn't fire
                        setTimeout(function(){ try{ node.remove(); } catch(e){} }, 900);
                    }, delay);
                }

                // auto-hide for non-sticky alarms after 3s: slide-out to right then remove
                // if you want a persistent (sticky) alarm, add class 'alarm-sticky' to the original element
                if (!a.classList.contains('alarm-sticky') && !t.classList.contains('alarm-sticky')) {
                    hideToast(t, 3000);
                }

                // allow click to dismiss quickly
                t.addEventListener('click', function(){ hideToast(t, 10); });
            });

            // bind to guest form to show intermediate prompts during submit
            try {
                var gf = document.getElementById('guestForm');
                if (gf) {
                    gf.addEventListener('submit', function(e){
                        try { window.showToast('请稍后，AI 正在检测文本是否存在违规...', {kind:'info', sticky:true}); } catch(err){}
                        try { window.showToast('正在提交，请稍候...', {kind:'success', delay:5000}); } catch(err){}
                    });
                }
            } catch(e){}

            // bind to delete forms to show quick feedback
            try {
                var dels = document.querySelectorAll('.guest-delete-form');
                dels.forEach(function(df){ df.addEventListener('submit', function(){ window.showToast('删除中，请稍候...', {kind:'info', sticky:false}); }); });
            } catch(e){}
        });
        </script>

    </body>

    </html>